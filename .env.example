# ------------------------------------------------------------------
# Solana dApp environment — copy to .env / app/.env.local and fill in
# ------------------------------------------------------------------

# --- Cluster / program ---
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Program ID (from anchor/target/deploy/my_project-keypair.json)
PROGRAM_ID=Eq53F3ZUR9HjhHpJfNkB53pZ4FXjtNm65uTym35zzexj
# Path to the deployer/admin keypair used by `anchor deploy`
ANCHOR_WALLET=~/.config/solana/id.json

# --- Frontend (app/.env.local) — NEXT_PUBLIC_* is exposed to browsers ---
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=Eq53F3ZUR9HjhHpJfNkB53pZ4FXjtNm65uTym35zzexj
NEXT_PUBLIC_ADMIN_PUBLIC_KEY=your_admin_wallet_base58

# Server-side only. Never expose this as NEXT_PUBLIC_ or commit a real key.
LI_FI_API_KEY=your_lifi_api_key
LI_FI_ROUTE_SECRET=generate_a_long_random_server_secret

# --- Server-side only (NEVER prefix with NEXT_PUBLIC_) ---
# WARNING: never put private keys in NEXT_PUBLIC_* variables — they are
# compiled into the public client bundle.
# ADMIN_PRIVATE_KEY=your_base58_private_key_for_admin

# --- Optional integrations ---
NEXT_PUBLIC_JUPITER_SWAP_URL=https://jup.ag/swap
NEXT_PUBLIC_AXIOM_API_URL=https://api.axiom.xyz
